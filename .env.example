# MongoDB Connection
# Get your connection string from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gearghar?retryWrites=true&w=majority

# JWT Secret for authentication
# Generate a secure random string (e.g., using: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Next.js Public API URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Email Configuration (optional, for future email functionality)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Stripe Configuration (optional, for payment processing)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...

# Google Gemini AI (for the AI motorcycle assistant chatbot)
# Get a key from https://aistudio.google.com/app/apikey
# If GEMINI_API_KEY is left blank the assistant automatically falls back to a
# rule-based mode that still recommends real catalogue products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional override of the API base URL:
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
